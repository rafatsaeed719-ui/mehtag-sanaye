app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/android/.gradle/
app/android/app/build/
app/android/build/
app/pubspec.lock
.idea/
*.iml

# Node
functions/node_modules/
*.log
.firebase/
site/
