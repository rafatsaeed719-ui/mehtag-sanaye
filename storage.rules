rules_version = '2';

// =============================================================
//  محتاج صنايعي — Storage Rules
//  صور البطاقة (idDocs) لا يقرأها إلا الإدارة، ولا تُنشأ لها روابط عامة
//  (وظيفة السيرفر stripIdDocTokens تحذف توكن الرابط العام فور الرفع).
// =============================================================
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isImage() { return request.resource.contentType.matches('image/.*'); }
    function under(mb) { return request.resource.size < mb * 1024 * 1024; }
    function requestDoc(rid) {
      return firestore.get(/databases/(default)/documents/requests/$(rid)).data;
    }

    // صورة شخصية
    match /users/{uid}/profile/{file} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && isImage() && under(5);
    }

    // صور أعمال سابقة للصنايعي
    match /workers/{uid}/works/{file} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && isImage() && under(5);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // البطاقة الشخصية — رفع من صاحبها فقط، قراءة للإدارة فقط
    match /idDocs/{uid}/{file} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && isImage() && under(8);
      allow update, delete: if false;
    }

    // صور المشكلة عند إنشاء الطلب (قبل وجود رقم الطلب)
    match /requestMedia/{uid}/{file} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && isImage() && under(5);
      allow update, delete: if false;
    }

    // صور الشات — أطراف الطلب فقط
    match /chatMedia/{requestId}/{file} {
      allow read: if isAdmin() || (signedIn() &&
        (requestDoc(requestId).customerId == request.auth.uid || requestDoc(requestId).workerId == request.auth.uid));
      allow create: if signedIn() && isImage() && under(5) &&
        (requestDoc(requestId).customerId == request.auth.uid || requestDoc(requestId).workerId == request.auth.uid);
      allow update, delete: if false;
    }

    // مرفقات البلاغات
    match /reports/{uid}/{file} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && isImage() && under(5);
      allow update, delete: if false;
    }

    // إيصالات تحويل العمولة (InstaPay)
    match /payments/{uid}/{file} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && isImage() && under(5);
      allow update, delete: if false;
    }

    // أيقونات المهن والخدمات (من لوحة التحكم)
    match /catalog/{file} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && under(2);
    }
  }
}
